# Supabase Configuration
# Obtain these from your Supabase Project Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Razorpay Payment Gateway (Test Mode / Live Mode)
# Razorpay Key ID (Client-side & Server-side accessible)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
# Razorpay Key Secret (Server-side ONLY - Never expose to client/browser)
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# WhatsApp Academic Support Hotline
# Default Medha Maths academic desk: +91 73708 10156
VITE_WHATSAPP_NUMBER="917370810156"
NEXT_PUBLIC_WHATSAPP_NUMBER="917370810156"

# GEMINI_API_KEY: Optional if server-side AI explanations are used
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
